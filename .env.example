# ==============================================================================
# Boardify Environment Configuration
# ==============================================================================
# NOTE: Boardify runs 100% out-of-the-box in local mode without any required env vars.
# Setting these Firebase variables enables real-time cloud sync & multiplayer across devices.

# Firebase Project Configuration (Optional - for Cloud Persistence & Multi-device Sync)
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyYourFirebaseApiKeyHere
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# Optional: Default AI Provider Keys for server-side / build environments
# (Note: Users can also enter their keys directly in the in-app Agent Studio Settings)
# NEXT_PUBLIC_OPENAI_API_KEY=sk-...
# NEXT_PUBLIC_GEMINI_API_KEY=AIzaSy...
# NEXT_PUBLIC_ANTHROPIC_API_KEY=sk-ant-...
